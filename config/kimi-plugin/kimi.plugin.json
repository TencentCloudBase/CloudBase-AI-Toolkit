{
  "$schema": "https://kimi.com/schemas/kimi.plugin.schema.json",
  "name": "cloudbase",
  "version": "0.2.0",
  "description": "Tencent CloudBase for Kimi Code / Kimi Work — generated from plugin/cloudbase shared assets (skills/hooks/mcp/assets/commands/agents) with a Kimi-specific manifest adapter.",
  "keywords": [
    "cloudbase",
    "tencent-cloud",
    "baas",
    "claude-code",
    "codebuddy",
    "openclaw",
    "ai-model",
    "database",
    "cloud-function",
    "authentication",
    "storage",
    "cloudrun",
    "kimi-code",
    "kimi-work"
  ],
  "author": "Tencent CloudBase",
  "homepage": "https://github.com/TencentCloudBase/cloudbase-plugin",
  "license": "MIT",
  "skills": "./skills/",
  "sessionStart": {
    "skill": "cloudbase"
  },
  "skillInstructions": "Use CloudBase MCP tools first. Run envQuery(action=info) before CloudBase operations. When login/auth is involved, configure provider capabilities first, then platform-specific auth flows.",
  "interface": {
    "displayName": "Tencent CloudBase",
    "shortDescription": "CloudBase MCP + shared skills/hooks for database, functions, auth, storage, CloudRun, and hosting",
    "longDescription": "Kimi native plugin generated from the shared CloudBase plugin assets. It reuses the same skills, hooks, MCP config, commands, agents, and logo as Claude/Codex/Cursor packaging, while keeping only the manifest format as Kimi-specific adaptation.",
    "developerName": "Tencent CloudBase",
    "websiteURL": "https://cloudbase.net",
    "category": "DEVELOPER_TOOLS",
    "hostKind": "local",
    "iconUrl": "https://raw.githubusercontent.com/TencentCloudBase/CloudBase-MCP/main/plugin/cloudbase/assets/logo.png"
  },
  "mcpServers": {
    "cloudbase": {
      "command": "npx",
      "args": [
        "-y",
        "@cloudbase/cloudbase-mcp@latest"
      ],
      "env": {
        "INTEGRATION_IDE": "Kimi Code"
      }
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/session-start-telemetry.mjs",
      "timeout": 5
    },
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/session-start-seen-skills.mjs",
      "timeout": 5
    },
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/session-start-profiler.mjs",
      "timeout": 5
    },
    {
      "event": "SessionStart",
      "matcher": "startup|resume|clear|compact",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/inject-session-context.mjs",
      "timeout": 5
    },
    {
      "event": "SessionEnd",
      "matcher": ".*",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/session-end-cleanup.mjs",
      "timeout": 5
    },
    {
      "event": "UserPromptSubmit",
      "matcher": ".*",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/user-prompt-submit-skill-inject.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit|apply_patch|Bash",
      "command": "node ./hooks/kimi-hook-adapter.mjs --script ./hooks/pretooluse-skill-inject.mjs",
      "timeout": 5
    }
  ]
}
