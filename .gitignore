# 根目录的同类 IDE / agent 产物：真源在 config/source/{skills,editor-config}，由
# npm run build:rules-sync / sync:config 生成到「使用者的项目根目录」。本仓在自身根目录
# 跑过同一套命令，产物就一直显示为未跟踪。按产物路径忽略，别让 git status 长期是脏的。
/.agent/
/.augment-guidelines
/.clinerules
/.codex/
/.comate/
/.gemini/
/.iflow/
/.kiro/
/.lingma/
/.mcp.json
/.opencode.json
/.qoder/
/.qwen/
/.roo/
/.rules/
/.trae/
/.windsurf/
/.claude/commands/
/.cursor/mcp.json
/.vscode/mcp.json
/.github/copilot-instructions.md
/IFLOW.md
/mcp.json
/rules/

# 以下三个目录里既有本仓自用的内部技能/规则（已入库），也有使用侧产物：整层忽略子项，
# 再放行入库的那些。**新增内部技能时，记得在这里补一行 `!`**，否则它会被忽略掉。
/.agents/skills/*
!/.agents/skills/api-contract-review/
!/.agents/skills/cloud-api-recipe-authoring/
!/.agents/skills/codebuddy-ide-mcp-upgrade/
!/.agents/skills/doc-freshness-review/
!/.agents/skills/docs-workflows/
!/.agents/skills/git-workflows/
!/.agents/skills/manage-local-skills/
!/.agents/skills/mcp-attribution-worktree/
!/.agents/skills/planning-workflows/
!/.agents/skills/review-automation-orchestrator/
!/.agents/skills/skill-authoring/
/.claude/skills/*
!/.claude/skills/api-contract-review/
!/.claude/skills/cloud-api-recipe-authoring/
!/.claude/skills/codebuddy-ide-mcp-upgrade/
!/.claude/skills/doc-freshness-review/
!/.claude/skills/manage-local-skills/
!/.claude/skills/mcp-attribution-worktree/
!/.claude/skills/review-automation-orchestrator/
!/.claude/skills/skill-authoring/
/.cursor/rules/*
!/.cursor/rules/project.mdc
.plugin-repo-output/

# Generated by scripts/sync-codebuddy-plugin.ts (marketplace sync regenerates)
config/codebuddy-plugin/skills/
dist/

# Specs: internal requirement / design / task docs (git 历史之外不再入库，私有归档另存)
specs/*
!specs/plugin-marketplace-listing/
!specs/npm-supply-chain-security-hardening/

# docs/: 只放对外文档（集成指南、公开调研）。内部工作件 —— 门禁报告、spec、
# 能力对齐表 —— 含真实环境 ID、内部任务号与责任人，本地保留、不入库。
/docs/*
!/docs/enterprise-auth-with-feishu.md
!/docs/research-codex-plugin-enterprise-auth.md

# 开发过程记录：真实环境 ID + 任务号 + 上线进度，本地保留、不入库。
dsh-plugin/community/SUBMISSION.md
dsh-plugin/scripts/t9-results.md
mcp/scripts/wxide-mcp-e2e-test.md

# .workbuddy: IDE local state (AI daily memory, plans, expert session history).
# 类比 .idea/ / .vscode/，本不该进版本控制；含内部任务 ID，私有归档另存。
.workbuddy/

# .cursor/plans: IDE 本地计划文件（含本机绝对路径与未公开的计划内容）。
# `.cursor/rules/` 是项目规范，有意入库；只有 plans/ 这一层属本地状态。
.cursor/plans/

# codebuddy-plugin/: 本地生成的 CodeBuddy 插件投影（由 sync 脚本产出，与 plugin/ 同源）。
# 生成物不入库，改 config/source/** 后重跑同步脚本即可重建。
codebuddy-plugin/

# 测试与构建残留
mcp/.tmp-*/
mcp/*.tgz
**/vitest.config.*.timestamp-*.mjs
tests/fixtures/readme-test/

# 发布产物目录的带时间戳变体（固定名 `.plugin-repo-output/` 见上；
# `.skills-repo-output*` 已在文件开头覆盖其全部变体）
.plugin-repo-output-*
