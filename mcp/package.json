{
  "name": "@cloudbase/cloudbase-mcp",
  "version": "2.25.7",
  "packageManager": "pnpm@10.8.0",
  "description": "CloudBase MCP Server \u2014 operate Tencent CloudBase (database, auth, functions, storage, hosting) from AI coding tools via the Model Context Protocol. Part of CloudBase AI Toolkit.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "cloudbase-mcp": "dist/cli.cjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/TencentCloudBase/CloudBase-AI-Toolkit",
  "bugs": {
    "url": "https://github.com/TencentCloudBase/CloudBase-AI-Toolkit/issues",
    "email": "bookerzhao@tencent.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TencentCloudBase/CloudBase-AI-Toolkit.git",
    "directory": "mcp"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "npm run build:webpack && npm run build:types && npm run build:permissions",
    "build:webpack": "NODE_OPTIONS=\"--max-old-space-size=8192\" webpack --config webpack/index.cjs --mode=production",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist/types && api-extractor run --local --verbose && cp dist/types/cli.d.ts dist/cli.d.ts && rm -rf dist/types",
    "build:permissions": "chmod 755 dist/cli.cjs",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:pg:cloud": "npm run build && node ./scripts/verify-pg-cloud-smoke.mjs",
    "test:cli:cloud-mode": "node ./scripts/verify-cli-cloud-mode-smoke.mjs",
    "test:npm:tarball-smoke": "node ./scripts/verify-npm-tarball-smoke.mjs",
    "test:inspector": "npm run build && npx @modelcontextprotocol/inspector node ./dist/cli.js",
    "prepublishOnly": "npm run build && node scripts/prepare-publish.cjs",
    "postpublish": "node scripts/restore-deps.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudbase",
    "tencent-cloud"
  ],
  "author": "TencentCloudBase",
  "license": "MIT",
  "dependencies": {
    "@cloudbase/cals": "^1.2.23",
    "@cloudbase/functions-framework": "^1.14.0",
    "@cloudbase/manager-node": "5.6.6",
    "@cloudbase/mcp": "1.0.0-beta.25",
    "@cloudbase/toolbox": "^0.8.1",
    "@modelcontextprotocol/sdk": "1.13.1",
    "@types/adm-zip": "^0.5.7",
    "adm-zip": "0.6.0",
    "cors": "^2.8.5",
    "express": "5.1.0",
    "fd-slicer": "^1.1.0",
    "lockfile": "^1.0.4",
    "open": "^10.1.2",
    "punycode": "^2.3.1",
    "unzipper": "^0.12.3",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "8.21.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.57.6",
    "@modelcontextprotocol/sdk": "^1.13.3",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/lockfile": "^1.0.4",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.12",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.0",
    "dotenv": "^16.4.5",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "process": "^0.11.10",
    "rollup": "^4.27.4",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-ignore": "^1.0.10",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "ts-loader": "^9.5.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.7",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "webpack-obfuscator": "^3.6.0"
  },
  "overrides": {
    "tough-cookie": "4.1.4",
    "js-yaml": "4.3.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "5.0.9",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "fast-uri": "3.1.5",
    "postcss": "8.5.25",
    "undici": "6.28.0",
    "body-parser": "2.3.0",
    "form-data": "2.5.6",
    "fast-xml-parser@4": "4.5.5",
    "ws@7": "7.5.11",
    "ws@8": "8.21.0",
    "path-to-regexp@8": "8.4.0",
    "serialize-javascript": "7.0.5",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@10": "10.2.5",
    "vite@5": "5.4.21",
    "adm-zip": "0.6.0",
    "decompress": "npm:@xhmikosr/decompress@11.1.3"
  }
}
