{
    "mcpServers": {
        "cloudbase": {
            "command": "npx",
            "args": [
                "-y",
                "@cloudbase/npm-launcher@1.0.0",
                "@cloudbase/cloudbase-mcp@latest"
            ],
            "timeout": 150000,
            "runtime": {
                "type": "node",
                "version": ">=20"
            },
            "npmRegistries": [
                "https://registry.npmmirror.com",
                "https://registry.npmjs.org"
            ],
            "env": {
                "INTEGRATION_IDE": "WorkBuddy",
                "CLOUDBASE_MCP_CLIENT": "workbuddy"
            }
        }
    },
    "preAuth": "cli"
}
